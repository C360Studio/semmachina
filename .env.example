# Copy this file to .env and supply the Gemini key used by `task run:gemini`.
# .env is ignored; never commit a real provider credential.
GEMINI_API_KEY=

# The paid Bellweather smoke also requires this exact explicit opt-in. It runs
# two bounded provider turn chains. Leave it disabled in ordinary development;
# the smoke task is absent from default/CI.
SEMMACHINA_PAID_SMOKE=0
